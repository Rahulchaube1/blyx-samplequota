use samplequota;

fn main() {
    let important = 3.0;
    let ordinary = 7.0;
    let capacity = 5.0;
    let result = samplequota_plan(important, ordinary, capacity);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
